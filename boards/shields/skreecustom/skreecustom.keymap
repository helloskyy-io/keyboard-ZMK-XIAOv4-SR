//#include <behaviors/mouse_keys.dtsi>

// Input processors + transform flags for trackball scroll/pointer tuning
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Base layer: QWERTY; bottom row has nav keys, layer toggles (mo 1 = left half, mo 2 = right half)
        default_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3     &kp N4     &kp N5      &kp N6   &kp N7     &kp N8     &kp N9    &kp N0    &kp EQUAL
&kp TAB    &kp Q   &kp W     &kp E      &kp R      &kp T       &kp Y    &kp U      &kp I      &kp O     &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S     &kp D      &kp F      &kp G       &kp H    &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp GRAVE  &kp Z   &kp X     &kp C      &kp V      &kp B       &kp N    &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp BSLH
&kp LEFT   &kp UP  &kp DOWN  &kp RIGHT                                             &kp LBKT   &kp RBKT  &kp RALT  &kp RCTRL
                             &kp LSHFT  &kp SPACE  &kp BSPC    &kp DEL  &kp RET    &kp RGUI
                                        &kp LALT   &mo 1       &mo 2    &kp RCTRL
            >;
        };

        // Layer 1: left-half layer (e.g. left-side layer toggle held)
        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans    &trans  &trans
            >;
        };

        // Layer 2: right-half layer (e.g. right-side layer toggle held)
        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans    &trans  &trans
            >;
        };

        // Layer 3: mouse layer (e.g. activated by right trackball); left/right click on center keys
        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                          &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans     &trans
                                &trans  &trans    &trans     &trans
            >;
        };
    };
};

// ─── Trackball configuration is NOT here ───
// All trackball input-processor settings (base speed, layer overrides) live in:
//   skreecustom.dtsi  →  trackball_central_listener   (left hand, scroll)
//   skreecustom.dtsi  →  trackball_peripheral_listener (right hand, pointer)
//
// The overlay files (skreecustom_left.overlay / skreecustom_right.overlay)
// handle hardware hookup and enabling only — they do NOT set input-processors.
//
// DO NOT add &trackball_*_listener overrides here — they would silently
// replace the dtsi values and cause hard-to-debug behavior changes.
